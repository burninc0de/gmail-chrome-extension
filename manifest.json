{
  "manifest_version": 3,
  "name": "Gmail Always Ask Save As",
  "version": "1.0.1",
  "description": "Forces the 'Save As' dialog when downloading files from Gmail.",
  "permissions": ["downloads", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
